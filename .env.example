# Copy this file to `.env` and fill in your key.
# On Railway, set these as service variables rather than committing a file.

# Required. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# UPSIDE_MODEL=claude-opus-5
# UPSIDE_EFFORT=high

# External research. Set to 0 to model without comparables or transaction
# evidence (the analysis still runs; the benchmark and multiple sections say so).
# UPSIDE_RESEARCH=1
# UPSIDE_RESEARCH_CACHE=.cache/research.json

# Resend — emails each finished analysis, with the PDF and JSON attached.
# Leave RESEND_API_KEY blank to disable delivery entirely.
RESEND_API_KEY=
REPORT_EMAIL_TO=Info@tencapital.group
# The From domain must be verified at resend.com/domains. The sandbox sender
# onboarding@resend.dev only delivers to the Resend account owner.
RESEND_FROM=TEN Capital Upside Case <reports@tencapital.group>
# EMAIL_REPORTS=0   # disable delivery without removing the key

# Web app.
# APP_PASSWORD gates the public URL. Leave unset for an open deploy.
# APP_PASSWORD=
# MAX_UPLOAD_MB=40
# JOB_TTL_MINUTES=60
